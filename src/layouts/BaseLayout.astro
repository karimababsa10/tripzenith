---
// BaseLayout.astro - Core layout shell for TripZenith
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, image } = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  "https://tripzenith.com"
);

const socialImage = image
  ? new URL(image, "https://tripzenith.com").toString()
  : "https://tripzenith.com/favicon.svg";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "TripZenith",
  url: "https://tripzenith.com/",
  description:
    "Travel guides, destination ideas, things to do, and practical travel tips for exploring the world.",
  publisher: {
    "@type": "Organization",
    name: "TripZenith",
    url: "https://tripzenith.com/",
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TripZenith",
  url: "https://tripzenith.com/",
  logo: {
    "@type": "ImageObject",
    url: "https://tripzenith.com/favicon.svg",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Character encoding & Viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{title} | TripZenith</title>
    <meta name="description" content={description || "Travel guides, destination ideas, and travel tips for exploring the world."} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph Metadata (Facebook / Slack / Discord sharing) -->
    <meta property="og:title" content={`${title} | TripZenith`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TripZenith" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | TripZenith`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Premium Google Fonts: Playfair Display (Serif) & Inter (Sans-serif) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Structured Data Schemas for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- Slot for pages that want to inject code into head -->
    <slot name="head" />
  </head>

  <body>
    <!-- Premium Extracted Header -->
    <Header />

    <!-- Main Content Slot -->
    <main class="page-content">
      <slot />
    </main>

    <!-- Premium Extracted Footer -->
    <Footer />
  </body>
</html>

<style is:global>
  /* Global Modern Editorial Theme Resets & Base Styles */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    background-color: #fcfbf9; /* Clean Warm Paper Canvas */
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #1f2937; /* Dark charcoal text for comfortable reading */
    background-color: #ffffff;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Utility container for page alignments */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Smooth Focus state style for all interactive elements to preserve accessibility */
  a:focus-visible, button:focus-visible, input:focus-visible {
    outline: 2.5px solid #bfa17f;
    outline-offset: 3px;
  }

  /* Core transition definitions */
  a, button {
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>
