---
const { title, description, image } = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  "https://tripzenith.com"
);

const socialImage = image
  ? new URL(image, "https://tripzenith.com").toString()
  : "https://tripzenith.com/favicon.svg";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "TripZenith",
  url: "https://tripzenith.com/",
  description:
    "Travel guides, destination ideas, things to do, and practical travel tips for exploring the world.",
  publisher: {
    "@type": "Organization",
    name: "TripZenith",
    url: "https://tripzenith.com/",
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "TripZenith",
  url: "https://tripzenith.com/",
  logo: {
    "@type": "ImageObject",
    url: "https://tripzenith.com/favicon.svg",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title} | TripZenith</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <link
      rel="canonical"
      href={canonicalURL}
    />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content={`${title} | TripZenith`}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="TripZenith"
    />

    <meta
      property="og:url"
      content={canonicalURL}
    />

    <meta
      property="og:image"
      content={socialImage}
    />

    <meta
      property="og:image:alt"
      content={title}
    />

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={`${title} | TripZenith`}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImage}
    />

    <meta
      name="twitter:image:alt"
      content={title}
    />

    <!-- Google Fonts -->
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- WebSite Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    <!-- Organization Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />

    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BN852Z77RL"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BN852Z77RL');
    </script>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">
          TripZenith
        </a>

        <nav class="main-nav">
          <a href="/">Home</a>
          <a href="/blog/">Blog</a>
          <a href="/destinations/">Destinations</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <a href="/" class="footer-logo">
            TripZenith
          </a>

          <p>
            Travel guides, destination ideas, and practical tips
            for exploring the world.
          </p>
        </div>

        <div class="footer-links">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms/">Terms</a>
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a>
        </div>
      </div>

      <div class="container footer-bottom">
        <p>
          © {new Date().getFullYear()} TripZenith. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    font-family:
      "Inter",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color: #111827;
    background: #ffffff;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    border-bottom: 1px solid #e5e7eb;
    background: #ffffff;
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #111827;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .main-nav a {
    font-size: 0.95rem;
    font-weight: 500;
    color: #4b5563;
    transition: color 0.2s ease;
  }

  .main-nav a:hover {
    color: #111827;
  }

  .site-footer {
    margin-top: 100px;
    border-top: 1px solid #e5e7eb;
    background: #f9fafb;
  }

  .footer-inner {
    padding: 55px 0 40px;
    display: flex;
    justify-content: space-between;
    gap: 60px;
  }

  .footer-logo {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .footer-inner p {
    max-width: 430px;
    margin: 12px 0 0;
    color: #6b7280;
    font-size: 0.95rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 14px 24px;
    max-width: 500px;
  }

  .footer-links a {
    color: #6b7280;
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: #111827;
  }

  .footer-bottom {
    padding: 20px 0 28px;
    border-top: 1px solid #e5e7eb;
  }

  .footer-bottom p {
    margin: 0;
    color: #9ca3af;
    font-size: 0.85rem;
  }

  @media (max-width: 700px) {
    .container {
      width: min(100% - 28px, 1180px);
    }

    .header-inner {
      min-height: auto;
      padding: 18px 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .main-nav {
      width: 100%;
      gap: 18px;
      flex-wrap: wrap;
    }

    .main-nav a {
      font-size: 0.88rem;
    }

    .footer-inner {
      padding: 40px 0 30px;
      flex-direction: column;
      gap: 30px;
    }

    .footer-links {
      justify-content: flex-start;
    }

    .site-footer {
      margin-top: 70px;
    }
  }
</style>