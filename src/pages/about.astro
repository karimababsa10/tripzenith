---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Us"
  description="Learn more about our travel website and our mission to help travelers discover amazing destinations."
>
  <main>
    <section class="container">
      <h1>About Us</h1>

      <p>
        Welcome to our travel website.
      </p>

      <p>
        We create practical travel guides, destination ideas,
        itineraries, and useful travel tips to help you plan
        better trips and discover new places around the world.
      </p>

      <p>
        Our goal is to make travel planning simpler by bringing
        useful information together in one place.
      </p>

      <h2>What We Share</h2>

      <ul>
        <li>Destination guides</li>
        <li>Travel itineraries</li>
        <li>Things to do</li>
        <li>Travel tips and advice</li>
        <li>Ideas for planning your next trip</li>
      </ul>

      <h2>Our Mission</h2>

      <p>
        We want to help travelers spend less time searching
        and more time enjoying their journeys.
      </p>
    </section>
  </main>
</BaseLayout>