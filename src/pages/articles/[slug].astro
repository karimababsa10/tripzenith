---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  return articles.map((article) => ({
    params: {
      slug: article.id,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allArticles = await getCollection("articles");

const matchedArticles = allArticles
  .filter((item) => item.id !== article.id)
  .filter(
    (item) =>
      item.data.destination === article.data.destination ||
      item.data.country === article.data.country ||
      item.data.region === article.data.region
  )
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const fallbackArticles = allArticles
  .filter((item) => item.id !== article.id)
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

const relatedArticles = (
  matchedArticles.length > 0 ? matchedArticles : fallbackArticles
).slice(0, 3);

const canonicalURL = new URL(
  `/articles/${article.id}/`,
  "https://tripzenith.com"
).toString();

const socialImage = article.data.image
  ? new URL(article.data.image, "https://tripzenith.com").toString()
  : "https://tripzenith.com/favicon.svg";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.data.title,
  description: article.data.description,
  image: socialImage,
  datePublished: article.data.pubDate.toISOString(),
  dateModified: article.data.pubDate.toISOString(),
  author: {
    "@type": "Organization",
    name: "TripZenith",
    url: "https://tripzenith.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "TripZenith",
    url: "https://tripzenith.com/",
    logo: {
      "@type": "ImageObject",
      url: "https://tripzenith.com/favicon.svg",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://tripzenith.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: "https://tripzenith.com/blog/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: article.data.destination,
      item: `https://tripzenith.com/destinations/${article.data.country
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")}/${article.data.destination
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "")}/`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: article.data.title,
      item: canonicalURL,
    },
  ],
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={article.data.image}
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={article.data.pubDate.toISOString()}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>

  <main class="article-page">
    <div class="container">

      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>

        <a href="/blog/">Blog</a>
        <span>/</span>

        <a href={`/destinations/${article.data.country
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")}/${article.data.destination
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")}/`}>
          {article.data.destination}
        </a>

        <span>/</span>

        <span>{article.data.title}</span>
      </nav>

      <div class="article-layout">

        <article class="article">

          <header class="article-header">

            <div class="article-category">
              {article.data.category}
            </div>

            <h1>{article.data.title}</h1>

            <p class="article-description">
              {article.data.description}
            </p>

            <div class="article-meta">
              <span>
                {article.data.destination}
              </span>

              <span>•</span>

              <time datetime={article.data.pubDate.toISOString()}>
                {article.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            </div>

          </header>

          {article.data.image && (
            <figure class="hero-image">
              <img
                src={article.data.image}
                alt={article.data.title}
                width="1200"
                height="675"
                loading="eager"
                decoding="async"
              />
            </figure>
          )}

          <div class="article-content">
            <Content />
          </div>

        </article>

        <aside class="sidebar">

          <div class="sidebar-box">

            <h2>Plan Your Trip</h2>

            <p>
              Discover more travel guides, destinations, and practical tips
              for your next adventure.
            </p>

            <a href="/destinations/" class="sidebar-button">
              Explore Destinations
            </a>

          </div>

          <div class="sidebar-box">

            <h2>Explore More</h2>

            <ul>
              <li>
                <a href="/blog/">Travel Guides</a>
              </li>

              <li>
                <a href="/destinations/">Destinations</a>
              </li>

              <li>
                <a href="/about/">About TripZenith</a>
              </li>
            </ul>

          </div>

        </aside>

      </div>

      {relatedArticles.length > 0 && (
        <section class="related-section">

          <div class="section-heading">
            <span>More Travel Guides</span>
            <h2>You May Also Like</h2>
          </div>

          <div class="related-grid">

            {relatedArticles.map((related) => (
              <a
                class="related-card"
                href={`/articles/${related.id}/`}
              >

                {related.data.image && (
                  <img
                    src={related.data.image}
                    alt={related.data.title}
                    loading="lazy"
                    width="600"
                    height="338"
                  />
                )}

                <div class="related-card-content">

                  <span class="related-category">
                    {related.data.category}
                  </span>

                  <h3>{related.data.title}</h3>

                  <p>{related.data.description}</p>

                  <span class="read-more">
                    Read Guide →
                  </span>

                </div>

              </a>
            ))}

          </div>

        </section>
      )}

      <section class="final-cta">

        <span>TRIPZENITH</span>

        <h2>Keep Exploring</h2>

        <p>
          Find your next destination and discover unforgettable things to do
          around the world.
        </p>

        <a href="/destinations/">
          Explore Destinations →
        </a>

      </section>

    </div>
  </main>
</BaseLayout>

<style>
  .article-page {
    padding: 48px 0 80px;
  }

  .container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 42px;
    color: #777;
    font-size: 14px;
  }

  .breadcrumbs a {
    color: #555;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: #111;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 60px;
    align-items: start;
  }

  .article-header {
    max-width: 900px;
  }

  .article-category {
    display: inline-block;
    margin-bottom: 18px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    max-width: 900px;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .article-description {
    max-width: 780px;
    margin: 24px 0 20px;
    color: #666;
    font-size: 20px;
    line-height: 1.65;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    color: #777;
    font-size: 14px;
  }

  .hero-image {
    margin: 42px 0;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18px;
  }

  .article-content {
    max-width: 820px;
    font-size: 18px;
    line-height: 1.8;
  }

  .article-content :global(h2) {
    margin-top: 52px;
    margin-bottom: 18px;
    font-size: 32px;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .article-content :global(h3) {
    margin-top: 34px;
    margin-bottom: 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  .article-content :global(p) {
    margin: 0 0 20px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 24px;
    padding-left: 28px;
  }

  .article-content :global(li) {
    margin-bottom: 8px;
  }

  .article-content :global(a) {
    color: #111;
    font-weight: 600;
  }

  .article-content :global(strong) {
    font-weight: 700;
  }

  .sidebar {
    position: sticky;
    top: 30px;
  }

  .sidebar-box {
    padding: 24px;
    margin-bottom: 20px;
    border: 1px solid #e5e5e5;
    border-radius: 16px;
    background: #fafafa;
  }

  .sidebar-box h2 {
    margin: 0 0 12px;
    font-size: 20px;
  }

  .sidebar-box p {
    margin: 0 0 20px;
    color: #666;
    line-height: 1.6;
  }

  .sidebar-box ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sidebar-box li {
    border-bottom: 1px solid #e5e5e5;
  }

  .sidebar-box li:last-child {
    border-bottom: 0;
  }

  .sidebar-box li a {
    display: block;
    padding: 12px 0;
    color: #222;
    text-decoration: none;
  }

  .sidebar-button {
    display: inline-block;
    padding: 11px 16px;
    border-radius: 8px;
    background: #111;
    color: white;
    text-decoration: none;
    font-weight: 600;
  }

  .related-section {
    margin-top: 90px;
    padding-top: 60px;
    border-top: 1px solid #e5e5e5;
  }

  .section-heading span {
    display: block;
    margin-bottom: 8px;
    color: #777;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .section-heading h2 {
    margin: 0 0 30px;
    font-size: 36px;
    letter-spacing: -0.03em;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .related-card {
    overflow: hidden;
    border: 1px solid #e5e5e5;
    border-radius: 16px;
    background: white;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
  }

  .related-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .related-card-content {
    padding: 20px;
  }

  .related-category {
    color: #777;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .related-card h3 {
    margin: 10px 0;
    font-size: 21px;
    line-height: 1.3;
  }

  .related-card p {
    margin: 0 0 18px;
    color: #666;
    font-size: 14px;
    line-height: 1.6;
  }

  .read-more {
    font-size: 14px;
    font-weight: 700;
  }

  .final-cta {
    margin-top: 90px;
    padding: 70px 30px;
    border-radius: 20px;
    background: #111;
    color: white;
    text-align: center;
  }

  .final-cta span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .final-cta h2 {
    margin: 14px 0;
    font-size: 42px;
    letter-spacing: -0.03em;
  }

  .final-cta p {
    max-width: 600px;
    margin: 0 auto 26px;
    color: #ccc;
    line-height: 1.7;
  }

  .final-cta a {
    display: inline-block;
    padding: 13px 20px;
    border-radius: 8px;
    background: white;
    color: #111;
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .sidebar {
      position: static;
    }

    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .article-page {
      padding-top: 30px;
    }

    .container {
      width: min(100% - 28px, 1180px);
    }

    .breadcrumbs {
      margin-bottom: 28px;
      font-size: 12px;
    }

    h1 {
      font-size: 38px;
    }

    .article-description {
      font-size: 17px;
    }

    .article-content {
      font-size: 17px;
    }

    .article-content :global(h2) {
      font-size: 28px;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .final-cta {
      padding: 50px 22px;
    }

    .final-cta h2 {
      font-size: 34px;
    }
  }
</style>