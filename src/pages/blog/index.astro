---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles");

const sortedArticles = articles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredArticle = sortedArticles[0];
const remainingArticles = sortedArticles.slice(1);
---

<BaseLayout
  title="Travel Blog — TripZenith"
  description="Explore travel guides, destination ideas, itineraries, and practical travel inspiration from TripZenith."
>

  <section class="blog-header">

    <p class="eyebrow">
      TRIPZENITH TRAVEL
    </p>

    <h1>
      Explore the world.
    </h1>

    <p class="intro">
      Travel guides, destination inspiration, and practical ideas
      for your next journey.
    </p>

  </section>


  {featuredArticle && (

    <section class="featured-section">

      <p class="section-label">
        LATEST GUIDE
      </p>

      <a
        href={`/articles/${featuredArticle.id}/`}
        class="featured"
      >

        {featuredArticle.data.image && (
          <div class="featured-image">
            <img
              src={featuredArticle.data.image}
              alt={featuredArticle.data.title}
            />
          </div>
        )}

        <div class="featured-content">

          <p class="date">
            {featuredArticle.data.pubDate.toLocaleDateString(
              "en-US",
              {
                year: "numeric",
                month: "long",
                day: "numeric"
              }
            )}
          </p>

          <h2>
            {featuredArticle.data.title}
          </h2>

          <p class="description">
            {featuredArticle.data.description}
          </p>

          <span class="read">
            Read guide →
          </span>

        </div>

      </a>

    </section>

  )}


  {remainingArticles.length > 0 && (

    <section class="latest-section">

      <div class="section-heading">

        <p class="section-label">
          MORE TO EXPLORE
        </p>

        <h2>
          Latest articles
        </h2>

      </div>


      <div class="articles-grid">

        {remainingArticles.map((article) => (

          <article class="article-card">

            {article.data.image && (
              <a
                href={`/articles/${article.id}/`}
                class="image-link"
              >
                <img
                  src={article.data.image}
                  alt={article.data.title}
                  loading="lazy"
                />
              </a>
            )}

            <div class="article-content">

              <p class="date">
                {article.data.pubDate.toLocaleDateString(
                  "en-US",
                  {
                    year: "numeric",
                    month: "long",
                    day: "numeric"
                  }
                )}
              </p>

              <h3>
                <a href={`/articles/${article.id}/`}>
                  {article.data.title}
                </a>
              </h3>

              <p class="description">
                {article.data.description}
              </p>

              <a
                href={`/articles/${article.id}/`}
                class="read"
              >
                Read article →
              </a>

            </div>

          </article>

        ))}

      </div>

    </section>

  )}


</BaseLayout>


<style>

.blog-header {
  max-width: 800px;
  margin: 2rem auto 5rem;
  text-align: center;
}

.eyebrow,
.section-label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: #777;
}

.eyebrow {
  margin-bottom: 1rem;
}

.blog-header h1 {
  margin: 0 0 1.2rem;
  font-size: clamp(3rem, 7vw, 5rem);
  line-height: 0.95;
  letter-spacing: -0.055em;
}

.intro {
  max-width: 600px;
  margin: 0 auto;
  color: #666;
  font-size: 1.1rem;
  line-height: 1.7;
}


/* FEATURED */

.featured-section {
  margin-bottom: 6rem;
}

.section-label {
  margin-bottom: 1rem;
}

.featured {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  overflow: hidden;
  background: #f1f1ed;
  border-radius: 24px;
  color: inherit;
  text-decoration: none;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.featured:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
}

.featured-image {
  min-height: 430px;
  overflow: hidden;
}

.featured-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.featured:hover .featured-image img {
  transform: scale(1.03);
}

.featured-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 3.5rem;
}

.date {
  margin-bottom: 0.7rem;
  color: #888;
  font-size: 0.78rem;
}

.featured-content h2 {
  margin-bottom: 1rem;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.05;
  letter-spacing: -0.045em;
}

.description {
  margin-bottom: 1.5rem;
  color: #666;
  line-height: 1.7;
}

.read {
  color: #111;
  font-weight: 700;
  text-decoration: none;
}


/* LATEST */

.latest-section {
  margin-bottom: 5rem;
}

.section-heading {
  margin-bottom: 2rem;
}

.section-heading h2 {
  margin-top: 0.5rem;
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.045em;
}


/* ARTICLE GRID */

.articles-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
}

.article-card {
  overflow: hidden;
  border: 1px solid #e8e8e5;
  border-radius: 20px;
  background: #fff;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.article-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.07);
}

.image-link {
  display: block;
  height: 260px;
  overflow: hidden;
}

.image-link img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.article-card:hover .image-link img {
  transform: scale(1.03);
}

.article-content {
  padding: 2rem;
}

.article-content h3 {
  margin-bottom: 1rem;
  font-size: 1.5rem;
  line-height: 1.15;
  letter-spacing: -0.03em;
}

.article-content h3 a {
  color: #111;
  text-decoration: none;
}


/* MOBILE */

@media (max-width: 800px) {

  .featured {
    grid-template-columns: 1fr;
  }

  .featured-image {
    min-height: 300px;
  }

  .featured-content {
    padding: 2rem;
  }

  .articles-grid {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 600px) {

  .blog-header {
    margin-bottom: 3rem;
  }

  .blog-header h1 {
    font-size: 3rem;
  }

  .featured-section {
    margin-bottom: 4rem;
  }

}

</style>