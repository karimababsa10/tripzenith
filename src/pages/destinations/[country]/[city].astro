---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  const slugify = (value) =>
    value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const destinations = [
    ...new Map(
      articles.map((article) => [
        `${article.data.country}|${article.data.destination}`,
        {
          country: article.data.country,
          destination: article.data.destination,
        },
      ])
    ).values(),
  ];

  return destinations.map(({ country, destination }) => ({
    params: {
      country: slugify(country),
      city: slugify(destination),
    },

    props: {
      country,
      destination,

      articles: articles
        .filter(
          (article) =>
            article.data.country === country &&
            article.data.destination === destination
        )
        .sort(
          (a, b) =>
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
        ),
    },
  }));
}

const {
  country,
  destination,
  articles: destinationArticles,
} = Astro.props;
---

<BaseLayout
  title={`${destination}, ${country} Travel Guide`}
  description={`Explore ${destination}, ${country} with travel guides, things to do, attractions, travel tips, and practical advice from TripZenith.`}
>
  <section class="city-header">
    <p class="eyebrow">TRIPZENITH DESTINATIONS</p>

    <h1>{destination}</h1>

    <p class="country-name">{country}</p>

    <p class="intro">
      Discover the best things to do, places to visit, and travel
      experiences in {destination}.
    </p>
  </section>

  <section class="articles-section">
    <div class="section-heading">
      <p class="section-label">TRAVEL GUIDES</p>
      <h2>Explore {destination}</h2>
    </div>

    <div class="articles-grid">
      {destinationArticles.map((article) => (
        <article class="article-card">
          {article.data.image && (
            <a
              href={`/articles/${article.id}/`}
              class="image-link"
            >
              <img
                src={article.data.image}
                alt={article.data.title}
                loading="lazy"
              />
            </a>
          )}

          <div class="article-content">
            <p class="date">
              {article.data.pubDate.toLocaleDateString(
                "en-US",
                {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                }
              )}
            </p>

            <p class="category">
              {article.data.category}
            </p>

            <h2>
              <a href={`/articles/${article.id}/`}>
                {article.data.title}
              </a>
            </h2>

            <p class="description">
              {article.data.description}
            </p>

            <a
              href={`/articles/${article.id}/`}
              class="read"
            >
              Read guide →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
.city-header {
  max-width: 800px;
  margin: 2rem auto 5rem;
  text-align: center;
}

.eyebrow {
  margin-bottom: 1rem;
  color: #777;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.city-header h1 {
  margin: 0;
  font-size: clamp(3.5rem, 8vw, 6rem);
  line-height: 0.95;
  letter-spacing: -0.06em;
}

.country-name {
  margin: 0.8rem 0 1.5rem;
  color: #777;
  font-size: 1.1rem;
  font-weight: 600;
}

.intro {
  max-width: 620px;
  margin: 0 auto;
  color: #666;
  font-size: 1.1rem;
  line-height: 1.7;
}

.section-heading {
  margin-bottom: 2rem;
}

.section-label {
  margin-bottom: 0.5rem;
  color: #777;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.section-heading h2 {
  font-size: 2rem;
  letter-spacing: -0.04em;
}

.articles-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2rem;
  margin-bottom: 5rem;
}

.article-card {
  overflow: hidden;
  border: 1px solid #e8e8e5;
  border-radius: 20px;
  background: #fff;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.article-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.07);
}

.image-link {
  display: block;
  height: 260px;
  overflow: hidden;
}

.image-link img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.article-card:hover .image-link img {
  transform: scale(1.03);
}

.article-content {
  padding: 2rem;
}

.date {
  margin-bottom: 0.3rem;
  color: #888;
  font-size: 0.78rem;
}

.category {
  margin-bottom: 0.8rem;
  color: #777;
  font-size: 0.78rem;
  font-weight: 600;
}

.article-content h2 {
  margin-bottom: 1rem;
  font-size: 1.5rem;
  line-height: 1.15;
  letter-spacing: -0.03em;
}

.article-content h2 a {
  color: #111;
  text-decoration: none;
}

.description {
  margin-bottom: 1.3rem;
  color: #666;
  line-height: 1.7;
}

.read {
  color: #111;
  font-weight: 700;
  text-decoration: none;
}

@media (max-width: 700px) {
  .articles-grid {
    grid-template-columns: 1fr;
  }

  .city-header {
    margin-bottom: 3rem;
  }
}
</style>
