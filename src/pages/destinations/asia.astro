---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const articles = await getCollection("articles");

const AsiaArticles = articles.filter(
  (article) => article.data.region === "Asia"
);

const countries = {};

for (const article of AsiaArticles) {
  const { country, destination } = article.data;

  if (!countries[country]) {
    countries[country] = new Set();
  }

  countries[country].add(destination);
}

const sortedCountries = Object.entries(countries).sort(([a], [b]) =>
  a.localeCompare(b)
);

const slugify = (value) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
---

<BaseLayout
  title="Asia Travel Destinations"
  description="Explore Asiaan countries, cities, destinations, and travel guides with TripZenith."
>

  <main class="region-page">

    <section class="destination-header">
      <p class="eyebrow">TRIPZENITH DESTINATIONS</p>

      <h1>Explore Asia.</h1>

      <p>
        Discover Asiaan countries, cities, landmarks, food, culture,
        and unforgettable travel experiences.
      </p>
    </section>


    <section class="directory-section">

      <div class="directory-container">

        <div class="section-heading">
          <p class="section-label">Asia</p>
          <h2>Choose a country.</h2>
          <p>
            Start with a country, then explore its cities and travel guides.
          </p>
        </div>


        <div class="country-grid">

          {sortedCountries.map(([country, destinations], index) => (

            <article class="country-card">

              <div class="country-top">
                <span class="country-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <a
                  href={`/destinations/${slugify(country)}/`}
                  class="country-arrow"
                  aria-label={`Explore ${country}`}
                >
                  ?
                </a>
              </div>

              <h3>
                <a href={`/destinations/${slugify(country)}/`}>
                  {country}
                </a>
              </h3>

              <p class="destination-label">
                DESTINATIONS
              </p>

              <div class="city-list">

                {[...destinations]
                  .sort((a, b) => a.localeCompare(b))
                  .map((destination) => (

                    <a
                      href={`/destinations/${slugify(country)}/${slugify(destination)}/`}
                      class="city-link"
                    >
                      <span>{destination}</span>
                      <span>?</span>
                    </a>

                  ))}

              </div>

              <a
                href={`/destinations/${slugify(country)}/`}
                class="explore-country"
              >
                Explore {country} ?
              </a>

            </article>

          ))}

        </div>

      </div>

    </section>

  </main>

</BaseLayout>


<style>

.region-page {
  background: #fafaf8;
  color: #111;
  min-height: 100vh;
}

.destination-header {
  max-width: 900px;
  margin: 0 auto;
  padding: 110px 20px 100px;
  text-align: center;
}

.eyebrow {
  margin: 0 0 25px;
  color: #888;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.destination-header h1 {
  margin: 0 0 28px;
  font-size: clamp(4rem, 9vw, 7rem);
  line-height: 0.88;
  letter-spacing: -0.075em;
}

.destination-header > p:last-child {
  max-width: 650px;
  margin: 0 auto;
  color: #666;
  font-size: 18px;
  line-height: 1.75;
}

.directory-section {
  padding: 110px 0 130px;
  background: #f1f0eb;
}

.directory-container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}

.section-heading {
  margin-bottom: 55px;
}

.section-label {
  margin: 0 0 12px;
  color: #888;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.17em;
}

.section-heading h2 {
  margin: 0 0 18px;
  font-size: clamp(3rem, 6vw, 5rem);
  line-height: 0.95;
  letter-spacing: -0.065em;
}

.section-heading > p:last-child {
  max-width: 500px;
  margin: 0;
  color: #707070;
  line-height: 1.7;
}

.country-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.country-card {
  padding: 28px;
  border: 1px solid #dedcd5;
  border-radius: 22px;
  background: #fff;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.country-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.07);
}

.country-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.country-number {
  color: #aaa;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.country-arrow {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid #ddd;
  border-radius: 50%;
  color: #111;
  text-decoration: none;
  transition: transform 0.2s ease;
}

.country-arrow:hover {
  transform: translate(2px, -2px);
}

.country-card h3 {
  margin: 32px 0 22px;
  font-size: 30px;
  line-height: 1;
  letter-spacing: -0.045em;
}

.country-card h3 a {
  color: #111;
  text-decoration: none;
}

.destination-label {
  margin: 0 0 8px;
  color: #aaa;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.city-list {
  display: flex;
  flex-direction: column;
}

.city-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 11px 0;
  border-bottom: 1px solid #e8e8e3;
  color: #555;
  font-size: 13px;
  text-decoration: none;
  transition: color 0.2s ease;
}

.city-link:last-child {
  border-bottom: none;
}

.city-link:hover {
  color: #111;
}

.explore-country {
  display: inline-block;
  margin-top: 22px;
  color: #111;
  font-size: 11px;
  font-weight: 700;
  text-decoration: none;
}

@media (max-width: 900px) {

  .country-grid {
    grid-template-columns: repeat(2, 1fr);
  }

}

@media (max-width: 600px) {

  .destination-header {
    padding: 80px 20px 70px;
  }

  .destination-header h1 {
    font-size: clamp(3.5rem, 17vw, 5rem);
  }

  .directory-section {
    padding: 80px 0;
  }

  .country-grid {
    grid-template-columns: 1fr;
  }

  .country-card {
    padding: 24px;
  }

}

</style>

