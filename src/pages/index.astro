];

// Latest Articles Data - Beginner friendly 6-card array
const latestArticles = [
  {
    title: "The Ultimate Guide to Hidden Cafés in Paris",
    description: "Skip the tourist traps and discover the best-kept culinary secrets tucked away in quiet alleys and leafy courtyards.",
    image: "https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=600&q=80",
    category: "Culinary",
    readTime: "5 Min Read",
    date: "Sep 12, 2026",
    link: "/blog/"
  },
  {
    title: "Chasing the Northern Lights in Reykjavik",
    description: "Everything you need to know about planning your dream winter expedition to Iceland's beautiful geothermal capital.",
    image: "https://images.unsplash.com/photo-1529963183134-61a90db47eaf?auto=format&fit=crop&w=600&q=80",
    category: "Adventure",
    readTime: "7 Min Read",
    date: "Sep 09, 2026",
    link: "/blog/"
  },
  {
    title: "A Design-Focused 3 Day Itinerary in Kyoto",
    description: "Explore traditional bamboo paths, minimal architecture, and timeless wooden temples in Japan's cultural heart.",
    image: "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=crop&w=600&q=80",
    category: "Itinerary",
    readTime: "6 Min Read",
    date: "Sep 05, 2026",
    link: "/blog/"
  },
  {
    title: "How to Spend an Art-Infused Weekend in London",
    description: "Navigate London's prestigious galleries, dynamic street art scenes, and private boutique galleries.",
    image: "https://images.unsplash.com/photo-1526129318478-62ed807ebdf9?auto=format&fit=crop&w=600&q=80",
    category: "Art & Museum",
    readTime: "4 Min Read",
    date: "Aug 29, 2026",
    link: "/blog/"
  },
  {
    title: "Finding Serenity in Bali's Sacred Retreats",
    description: "Unwind in the misty rainforests and vibrant terraced rice fields of Ubud's world-renowned holistic centers.",
    image: "https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=600&q=80",
    category: "Wellness",
    readTime: "8 Min Read",
    date: "Aug 22, 2026",
    link: "/blog/"
  },
  {
    title: "A Slow Traveler's Guide to the Amalfi Coast",
    description: "Discover a relaxed pace of coastal living, pastel-colored villages, and local lemon orchards.",
    image: "https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=600&q=80",
    category: "Culture",
    readTime: "5 Min Read",
    date: "Aug 15, 2026",
    link: "/blog/"
  }
];
---

<BaseLayout
  title="TripZenith — Curated Travel Inspiration & Editorial Guides"
  description="Discover handpicked travel destinations, modern design-focused itineraries, and beautiful visual guides designed for the premium editorial traveler."
>
  
  <!-- HERO SECTION -->
  <section class="hero-section">
    <div class="hero-bg-overlay"></div>
    <div class="hero-content">
      <span class="hero-eyebrow">CURATED EDITORIAL TRAVELS</span>
      <h1 class="hero-title">Discover Your<br>Next Adventure</h1>
      <p class="hero-subtitle">Modern travel guides, design-focused itineraries, and beautiful visual stories designed for the intentional explorer.</p>
      <div class="hero-cta-wrapper">
        <a href="#destinations" class="hero-primary-cta">Explore Destinations</a>
        <a href="/blog/" class="hero-secondary-cta">Read the Blog</a>
      </div>
    </div>
  </section>

  <!-- FEATURED DESTINATIONS SECTION -->
  <section id="destinations" class="destinations-section container">
    <div class="section-header">
      <div class="section-title-block">
        <span class="section-eyebrow">DISCOVERY</span>
        <h2 class="section-title">Featured Destinations</h2>
      </div>
      <p class="section-intro">Handpicked global locations chosen for their outstanding architecture, rich artistic heritage, and outstanding natural landscapes.</p>
    </div>

    <!-- Destination Grid -->
    <div class="destinations-grid">
      {featuredDestinations.map((dest) => (
        <a href={dest.link} class="destination-card">
          <div class="card-image-wrapper">
            <img src={dest.image} alt={`Beautiful scenery in ${dest.name}`} loading="lazy" />
            <div class="card-overlay"></div>
          </div>
          <div class="destination-card-content">
            <p class="destination-country">{dest.country}</p>
            <h3 class="destination-name">{dest.name}</h3>
            <span class="destination-guide-count">{dest.articleCount}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- LATEST ARTICLES SECTION -->
  <section class="articles-section container">
    <div class="section-header">
      <div class="section-title-block">
        <span class="section-eyebrow">EDITORIAL FEED</span>
        <h2 class="section-title">Latest Articles</h2>
      </div>
      <a href="/blog/" class="explore-all-link">View All Travel Tips →</a>
    </div>

    <!-- Article Column Grid -->
    <div class="articles-grid">
      {latestArticles.map((article) => (
        <article class="article-card">
          <a href={article.link} class="article-image-link">
            <div class="article-image-wrapper">
              <img src={article.image} alt={article.title} loading="lazy" />
              <div class="article-image-overlay"></div>
            </div>
          </a>
          <div class="article-card-content">
            <div class="article-meta">
              <span class="article-category">{article.category}</span>
              <span class="meta-dot"></span>
              <span class="article-read-time">{article.readTime}</span>
            </div>
            <h3 class="article-title">
              <a href={article.link}>{article.title}</a>
            </h3>
            <p class="article-description">{article.description}</p>
            <div class="article-footer">
              <span class="article-date">{article.date}</span>
              <a href={article.link} class="read-more-text">Read Article →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- NEWSLETTER SIGNUP SECTION -->
  <section id="newsletter" class="newsletter-section">
    <div class="newsletter-container container">
      <div class="newsletter-content">
        <span class="newsletter-eyebrow">JOIN TRIPZENITH CLUB</span>
        <h2 class="newsletter-title">Subscribe to the Newsletter</h2>
        <p class="newsletter-description">Receive once-monthly editorial travel newsletters containing hand-curated design travel spots, hotel listings, and slow-travel tips directly in your inbox.</p>
        
        <!-- Subscription Form -->
        <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing to TripZenith!');">
          <input 
            type="email" 
            placeholder="Enter your email address" 
            required 
            class="newsletter-input" 
            aria-label="Email Address" 
          />
          <button type="submit" class="newsletter-submit-btn">Subscribe</button>
        </form>
        <p class="newsletter-subtext">We value your privacy. Unsubscribe at any time. No spam.</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* --- HERO SECTION STYLING --- */
  .hero-section {
    height: 85vh;
    min-height: 600px;
    background-image: linear-gradient(rgba(17, 24, 39, 0.45), rgba(17, 24, 39, 0.45)), url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=1920&q=80');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    position: relative;
    color: #ffffff;
    margin-bottom: 120px;
  }

  .hero-content {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
    z-index: 10;
  }

  .hero-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #bfa17f; /* Ochre brand color */
    margin-bottom: 24px;
    display: inline-block;
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.15;
    font-weight: 700;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 400;
    line-height: 1.65;
    color: #f3f4f6; /* Very light slate grey */
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta-wrapper {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .hero-primary-cta {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    background-color: #bfa17f;
    color: #ffffff;
    text-decoration: none;
    padding: 16px 32px;
    border-radius: 4px;
    box-shadow: 0 4px 12px rgba(191, 161, 127, 0.2);
  }

  .hero-primary-cta:hover {
    background-color: #a38360;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(191, 161, 127, 0.35);
  }

  .hero-secondary-cta {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    background-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    text-decoration: none;
    padding: 16px 32px;
    border-radius: 4px;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .hero-secondary-cta:hover {
    background-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }


  /* --- GENERAL SECTION HEADERS --- */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 48px;
  }

  .section-title-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .section-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #bfa17f;
  }

  .section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.2rem;
    color: #111827;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .section-intro {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #5c646f;
    line-height: 1.6;
    max-width: 480px;
    margin: 0;
  }

  .explore-all-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #111827;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1.5px solid #bfa17f;
  }

  .explore-all-link:hover {
    color: #bfa17f;
  }


  /* --- DESTINATIONS SECTION --- */
  .destinations-section {
    margin-bottom: 120px;
  }

  .destinations-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .destination-card {
    position: relative;
    height: 400px;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .card-image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(to top, rgba(17, 24, 39, 0.85) 0%, rgba(17, 24, 39, 0) 60%);
    z-index: 2;
  }

  /* Card Hover Animations */
  .destination-card:hover .card-image-wrapper img {
    transform: scale(1.08); /* Sophisticated hover zoom */
  }

  .destination-card-content {
    position: relative;
    z-index: 3;
    padding: 30px;
    width: 100%;
  }

  .destination-country {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #bfa17f;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .destination-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: 0.01em;
  }

  .destination-guide-count {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #e5e7eb;
    display: block;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* Slide up metadata on hover */
  .destination-card:hover .destination-guide-count {
    opacity: 1;
    transform: translateY(0);
  }


  /* --- ARTICLES SECTION --- */
  .articles-section {
    margin-bottom: 120px;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border-radius: 4px;
    overflow: hidden;
  }

  .article-image-wrapper {
    position: relative;
    height: 240px;
    overflow: hidden;
    border-radius: 4px;
  }

  .article-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .article-image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(17, 24, 39, 0.05);
    transition: background-color 0.3s ease;
  }

  .article-card:hover .article-image-wrapper img {
    transform: scale(1.05);
  }

  .article-card:hover .article-image-overlay {
    background-color: rgba(17, 24, 39, 0);
  }

  .article-card-content {
    padding: 24px 0 0 0; /* Padding-free card edges for neat editorial style */
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .article-category {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #bfa17f;
    letter-spacing: 0.05em;
  }

  .meta-dot {
    width: 4px;
    height: 4px;
    background-color: #d1d5db;
    border-radius: 50%;
  }

  .article-read-time {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #7c848f;
  }

  .article-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 12px;
  }

  .article-title a {
    color: #111827;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .article-title a:hover {
    color: #bfa17f;
  }

  .article-description {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: #5c646f;
    line-height: 1.6;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    border-top: 1px solid #f3f4f6;
    padding-top: 16px;
  }

  .article-date {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #9ca3af;
  }

  .read-more-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: #111827;
    text-decoration: none;
  }

  .read-more-text:hover {
    color: #bfa17f;
  }


  /* --- NEWSLETTER SIGNUP SECTION --- */
  .newsletter-section {
    background-color: #faf9f6; /* Warm paper canvas background */
    border-top: 1px solid #f0edf0;
    border-bottom: 1px solid #f0edf0;
    padding: 100px 0;
  }

  .newsletter-content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #bfa17f;
    margin-bottom: 16px;
    display: inline-block;
  }

  .newsletter-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.2rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 16px;
  }

  .newsletter-description {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #5c646f;
    line-height: 1.65;
    margin-bottom: 36px;
  }

  .newsletter-form {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
  }

  .newsletter-input {
    flex-grow: 1;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    padding: 16px 24px;
    border: 1px solid #dcdad5;
    border-radius: 4px;
    background-color: #ffffff;
    color: #1f2937;
  }

  .newsletter-submit-btn {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    background-color: #111827;
    color: #ffffff;
    border: none;
    padding: 16px 36px;
    border-radius: 4px;
    cursor: pointer;
  }

  .newsletter-submit-btn:hover {
    background-color: #bfa17f;
  }

  .newsletter-subtext {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #9ca3af;
    margin: 0;
  }


  /* --- RESPONSIVE STYLE BREAKPOINTS --- */
  @media (max-width: 1024px) {
    .destinations-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      height: 70vh;
      min-height: 500px;
      margin-bottom: 80px;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 36px;
    }

    .section-intro {
      max-width: 100%;
    }

    .destinations-section {
      margin-bottom: 80px;
    }

    .articles-section {
      margin-bottom: 80px;
    }

    .newsletter-section {
      padding: 70px 0;
    }

    .newsletter-form {
      flex-direction: column;
      gap: 12px;
    }

    .newsletter-submit-btn {
      width: 100%;
    }
  }

  @media (max-width: 576px) {
    .destinations-grid {
      grid-template-columns: 1fr;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .destination-card {
      height: 350px;
    }
  }
</style>
