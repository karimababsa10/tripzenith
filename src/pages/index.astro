---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

// Fetch all articles first — needed by both sections below
const allArticles = await getCollection("articles");

// Featured Destinations - built dynamically from real articles
const slugify = (value) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const destinationMap = {};

for (const article of allArticles) {
  const { destination, country, image } = article.data;
  const key = `${destination}|${country}`;

  if (!destinationMap[key]) {
    destinationMap[key] = {
      name: destination,
      country: country,
      image:
        image ||
        "https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=800&q=80",
      count: 0,
      link: `/destinations/${slugify(country)}/`,
    };
  }

  destinationMap[key].count += 1;
}

const featuredDestinations = Object.values(destinationMap)
  .sort((a, b) => b.count - a.count)
  .slice(0, 4)
  .map((dest) => ({
    ...dest,
    articleCount: `${dest.count} Guide${dest.count > 1 ? "s" : ""}`,
  }));

// Latest Articles - pulled dynamically from real content, newest first
const latestArticles = allArticles
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
---

<BaseLayout
  title="TripZenith — Travel Guides & Inspiration"
  description="Travel guides, destination ideas, itineraries and practical travel tips for your next adventure."
>

  <!-- HERO -->

  <section class="hero">
    <div class="container hero-inner">

      <div class="hero-text">
        <p class="eyebrow">TRAVEL GUIDES & INSPIRATION</p>

        <h1>
          Discover your<br />
          next adventure.
        </h1>

        <p class="hero-description">
          Practical travel guides, beautiful destinations,
          and ideas to help you plan your next trip.
        </p>

        <div class="hero-buttons">
          <a href="/blog/" class="primary-button">
            Explore travel guides
          </a>

          <a href="/destinations/" class="secondary-button">
            Browse destinations
          </a>
        </div>
      </div>

      <div class="hero-image">
        <img
          src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=85"
          alt="Beautiful travel destination"
        />
      </div>

    </div>
  </section>


  <!-- LATEST ARTICLES -->

  <section class="articles-section">
    <div class="container">

      <div class="section-heading">
        <div>
          <p class="eyebrow">LATEST</p>
          <h2>Latest travel guides</h2>
        </div>

        <a href="/blog/" class="view-all">
          View all →
        </a>
      </div>


      <div class="articles-grid">

        {latestArticles.map((article) => (

          <article class="article-card">

            <a href={`/articles/${article.slug}/`} class="image-link">

              {article.data.image && (
                <img
                  src={article.data.image}
                  alt={article.data.title}
                  loading="lazy"
                />
              )}

            </a>

            <div class="article-content">

              <div class="article-meta">
                <span>{article.data.category}</span>
                <span>•</span>
                <span>
                  {article.data.pubDate.toLocaleDateString(
                    "en-US",
                    {
                      month: "short",
                      day: "numeric",
                      year: "numeric"
                    }
                  )}
                </span>
              </div>

              <h3>
                <a href={`/articles/${article.slug}/`}>
                  {article.data.title}
                </a>
              </h3>

              <p>
                {article.data.description}
              </p>

              <a
                href={`/articles/${article.slug}/`}
                class="read-more"
              >
                Read article →
              </a>

            </div>

          </article>

        ))}

      </div>

    </div>
  </section>


  <!-- SIMPLE CTA -->

  <section class="cta-section">

    <div class="container cta">

      <p class="eyebrow">PLAN YOUR NEXT TRIP</p>

      <h2>
        Where will you go next?
      </h2>

      <p>
        Explore our latest destinations, travel guides,
        and practical tips.
      </p>

      <a href="/destinations/" class="primary-button">
        Explore destinations
      </a>

    </div>

  </section>

</BaseLayout>


<style>

  .hero {
    padding: 70px 0 80px;
    border-bottom: 1px solid #eeeeee;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: #2563eb;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    font-weight: 800;
  }

  .hero-description {
    max-width: 550px;
    margin: 24px 0 30px;
    color: #6b7280;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .hero-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .primary-button,
  .secondary-button {
    display: inline-block;
    padding: 12px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .primary-button {
    background: #2563eb;
    color: white;
  }

  .primary-button:hover {
    background: #1d4ed8;
  }

  .secondary-button {
    border: 1px solid #d1d5db;
    color: #374151;
    background: white;
  }

  .secondary-button:hover {
    border-color: #2563eb;
    color: #2563eb;
  }

  .hero-image {
    height: 480px;
    overflow: hidden;
    border-radius: 14px;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  /* ARTICLES */

  .articles-section {
    padding: 90px 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 35px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 2.2rem;
    letter-spacing: -0.04em;
  }

  .view-all {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .article-card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    background: white;
  }

  .image-link {
    display: block;
    height: 220px;
    overflow: hidden;
  }

  .image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .article-card:hover .image-link img {
    transform: scale(1.03);
  }

  .article-content {
    padding: 22px;
  }

  .article-meta {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
    color: #6b7280;
    font-size: 0.78rem;
  }

  .article-meta span:first-child {
    color: #2563eb;
    font-weight: 600;
  }

  .article-content h3 {
    margin: 0 0 12px;
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .article-content h3 a {
    color: #111827;
    text-decoration: none;
  }

  .article-content h3 a:hover {
    color: #2563eb;
  }

  .article-content p {
    margin: 0 0 18px;
    color: #6b7280;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .read-more {
    color: #2563eb;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }


  /* CTA */

  .cta-section {
    padding: 90px 0;
    background: #f8fafc;
  }

  .cta {
    text-align: center;
    max-width: 650px;
  }

  .cta h2 {
    margin: 0 0 15px;
    font-size: 2.5rem;
    letter-spacing: -0.04em;
  }

  .cta p:not(.eyebrow) {
    margin: 0 auto 25px;
    color: #6b7280;
  }


  /* MOBILE */

  @media (max-width: 850px) {

    .hero {
      padding: 50px 0 60px;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .hero-image {
      height: 350px;
    }

    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 600px) {

    .container {
      width: min(100% - 30px, 1180px);
    }

    .hero-image {
      height: 280px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .cta h2 {
      font-size: 2rem;
    }

  }

</style>